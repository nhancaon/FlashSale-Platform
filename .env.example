# Giá trị cho môi trường dev local. Copy thành .env (make up tự làm). Không commit .env.
ORACLE_PASSWORD=dev_sys_password
APP_USER=flashsale
APP_USER_PASSWORD=dev_app_password
ORACLE_SERVICE=FREEPDB1

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=dev_grafana_password

# Cổng Redis trên máy host (6379 hay bị Redis khác chiếm)
REDIS_HOST_PORT=6380

# Gateway (Phase 5). Dev values only: change both outside local development.
JWT_SECRET=dev-only-jwt-secret-please-change-0123456789abcdef
DEMO_PASSWORD=dev_demo_password

# Ansible Vault password of the lab (ansible/group_vars/all/vault.yml). A real environment keeps its own vault
# file and password in a secret store (CI: repository secret), never in a file like this one.
FLASHSALE_VAULT_PASSWORD=dev-only-vault-password
